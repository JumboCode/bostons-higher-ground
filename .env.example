# Copy to .env.local; use handoff settings.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Salesforce sync
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_URL=https://login.salesforce.com
# Verified BHG program Account record type API name (label: FLSI Household).
# Keep records with missing Family_Id__c in scope so admins can fix them.
SALESFORCE_QUERY_FILTER="RecordType.DeveloperName = 'FLSI_Household'"

# Synthetic BPS upload preview on /admin (mock data only). Leave unset in production.
# NEXT_PUBLIC_ENABLE_BPS_PREVIEW=true
